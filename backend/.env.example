# Copy to backend/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Optional CORS origin. Leave * for local assessment clients.
CORS_ORIGIN=*

# PostgreSQL is reserved for later persistence. Leave unset in Phase 1.
# The API does not query a database yet.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
