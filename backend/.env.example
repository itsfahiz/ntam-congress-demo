# Copy to backend/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Optional CORS origin. Leave * for local assessment clients.
CORS_ORIGIN=*

# Supabase Postgres connection string (Project Settings → Database).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth (Project Settings → API). Used to verify access tokens.
# Never put the service-role key in this app or in Git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini. Put the real key only in backend/.env or the host env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_THINKING_BUDGET=0

# Assistant HTTP limits
ASSISTANT_RATE_LIMIT_MAX=10
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
