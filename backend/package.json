{
  "name": "ntam-congress-api",
  "version": "1.0.0",
  "private": true,
  "description": "Nestlé Medical Congress API for the NTAM assessment.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "test": "tsx --test tests/api.test.ts tests/assistant.test.ts tests/retrieval.test.ts tests/questions.test.ts tests/badge.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
